# Example environment variables for local development
# Copy this to `.env` and fill in real values. Command to copy is below:
#    Copy-Item .env.example -Destination .env

# Database URL (example for Postgres)
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# Secret key for signing tokens
SECRET_KEY=replace-me-with-a-secure-random-string

# JWT configuration
JWT_ALG=replace-with-your-jwt-algorithm
ACCESS_TOKEN_MINUTES=replace-with-access-token-expiry-in-minutes
REFRESH_TOKEN_DAYS=replace-with-refresh-token-expiry-in-days
